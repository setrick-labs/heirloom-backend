# Copy to .env and fill in for local development.

NODE_ENV=development
PORT=3000

# postgres://user:password@host:port/database
DATABASE_URL=postgres://heirloom:heirloom@localhost:5432/heirloom

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=*

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10

# Cloudflare R2 (S3-compatible) — optional locally; storage.service.ts
# throws a clear error only if something actually tries to use it unset.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

LOG_LEVEL=info
