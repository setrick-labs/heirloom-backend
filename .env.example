# Copy to .env and fill in for local development.

NODE_ENV=development
PORT=3000

# postgres://user:password@host:port/database
# Demand TLS on the database connection. Defaults to true in production.
# Set false only for a database that genuinely cannot offer TLS — and note
# that means credentials and content cross the network in the clear.
DATABASE_SSL=

DATABASE_URL=postgres://heirloom:heirloom@localhost:5432/heirloom

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=*

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10

# Object storage — standard AWS SDK env var names (AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_REGION), works against any S3-compatible
# service by pointing S3_ENDPOINT at it. Optional locally; storage.service.ts
# throws a clear error only if something actually tries to use it unset.
#
# Production target is Cloudflare R2: set S3_ENDPOINT to
# https://<accountId>.r2.cloudflarestorage.com, leave S3_FORCE_PATH_STYLE
# false.
#
# For local dev before R2 is set up, point at any S3-compatible service
# instead (e.g. a self-hosted SeaweedFS S3 gateway): set S3_ENDPOINT to its
# URL and S3_FORCE_PATH_STYLE=true (most non-R2 S3-compatible services need
# path-style URLs).
#
# Verify these are correct with: pnpm run storage:verify
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_BUCKET_NAME=

LOG_LEVEL=info

# --- Outbound email (optional) --------------------------------------------
# With SMTP_HOST unset the app logs verification codes, reset tokens and gift
# invites instead of sending them — a supported local mode, not a failure.
# Plain SMTP, so any provider works (Resend, Postmark, SES, Mailgun, a relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS on 465, false for STARTTLS on 587
SMTP_SECURE=false
# Must be an address your SMTP account may send as.
MAIL_FROM=
